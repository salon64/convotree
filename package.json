{
  "name": "convotree",
  "version": "0.1.0",
  "description": "Fold agent sub-tasks into structured summaries — a branching conversation-tree engine, CLI, and MCP server for LLM workflows.",
  "license": "MIT",
  "author": "Malcolm Malle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salon64/convotree.git"
  },
  "homepage": "https://github.com/salon64/convotree#readme",
  "bugs": "https://github.com/salon64/convotree/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai-agent",
    "context-folding",
    "conversation-tree",
    "cli",
    "anthropic",
    "openai"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli/index.js",
    "./mcp": "./dist/mcp/server.js"
  },
  "bin": {
    "convotree": "./dist/cli/index.js",
    "convotree-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test:phase0": "node scripts/phase0-test.mjs",
    "test:lib": "node scripts/lib-smoke.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^9.4.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^17.4.2",
    "openai": "^6.39.1",
    "uuid": "^9.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
