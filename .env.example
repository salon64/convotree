# convotree — environment variables
# Copy this file to `.env` and fill in your key(s). `.env` is gitignored.

# Anthropic API key — required for the default provider.
# Generate one at https://console.anthropic.com/ (API keys). Pay-as-you-go,
# billed separately from any Claude.ai subscription.
ANTHROPIC_API_KEY=

# OpenAI API key — only needed if you set "provider": "openai" in ~/.convotree/config.json
# OPENAI_API_KEY=

# Other providers — only needed if you set "provider" (or fold_provider) to that name
# in ~/.convotree/config.json. Keys are read from <PROVIDER>_API_KEY (see README
# "Configuration"). ollama runs locally and needs no key.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
